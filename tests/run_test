#!/usr/bin/env bash

# Script that runs a single test module (or directory) of the test suite.
#
# Arguments:
#   1. The test to run, relative to the tests directory, e.g. "unit/test_util.py" or "columnar".
#   2+. Further arguments forwarded to pytest, e.g. "-k four_vec".

action() {
    local shell_is_zsh=$( [ -z "${ZSH_VERSION}" ] && echo "false" || echo "true" )
    local this_file="$( ${shell_is_zsh} && echo "${(%):-%x}" || echo "${BASH_SOURCE[0]}" )"
    local this_dir="$( cd "$( dirname "${this_file}" )" && pwd )"

    local mod="$1"
    if [ -z "${mod}" ]; then
        2>&1 echo "missing test to run (argument 1)"
        return "1"
    fi
    shift

    echo "testing ${mod} ..."
    bash "${this_dir}/run_tests" "tests/${mod}" "$@"
}
action "$@"
